# Runtime output. These directories are created by Initialize-WplRuntimeDirectory
# on first run, so no placeholder file is tracked to hold the tree open.
reports/
recommendations/
sessions/
logs/
downloads/
.retired/
offline-packs/

# The tools tree keeps only its bilingual purpose documentation; Setup-Tools.ps1
# creates the per-tool directories and third-party binaries never land in git.
tools/*
!tools/README.md
!tools/*/
tools/*/*
!tools/*/README.md
*.log
*.tmp
.vs/
.idea/
dist/
exa-results/
testResults.xml

# Per-machine tool path overrides. Paths are local to one operator's machine.
config/user-tool-paths.json

# Internal working documents: implementation audit, roadmap, agent instructions
# and the third-party brand analysis used while building the palette.
AGENTS.md
DESIGN.md
docs/ko/PRODUCT_PLAN.md
docs/en/PRODUCT_PLAN.md
